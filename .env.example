# Copy to .env and adjust. Never commit the real .env.

# Runtime
NODE_ENV=development
PORT=24202
LOG_LEVEL=info

# Database: single-node replica set, see docker-compose.yml
MONGODB_URI=mongodb://localhost:24203/?replicaSet=rs0&directConnection=true
MONGODB_DB=collab_kit

# Token of the docking tool. The service verifies it and never issues one itself.
# Algorithm the tool signs with, RS256 when blank. RS, PS and ES algorithms check against the
# tool's public key: fetched from the key set (JWKS) it publishes at JWT_JWKS_URI, or fixed as
# PEM in JWT_PUBLIC_KEY. Set only one of the two.
JWT_ALGORITHM=RS256
JWT_JWKS_URI=https://tool.example/oauth2/jwks
# JWT_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----"
# HS256, HS384 and HS512 check against a secret shared with the tool instead, e.g. for
# self-signed test tokens:
# JWT_ALGORITHM=HS256
# JWT_SECRET=replace-me-locally
# Expected iss and aud; blank means not checked. Set both when the issuer signs tokens for
# more than one application, or a token meant for another one passes too. JWT_AUDIENCE takes
# a comma-separated list, one entry must match.
JWT_ISSUER=
JWT_AUDIENCE=
# Claims that carry the actor key and the name to show. Change them only for a tool
# that does not put its user into the standard claims. Blank means the default.
# The actor claim must be unique per person and never change: no email, no user name.
ACTOR_CLAIM=sub
LABEL_CLAIM=name
# Who may everything everywhere, as the docking tool names it in its token: the claim and
# the comma-separated values that count. The claim may hold one value or a list. Set both or
# neither; blank means nobody, and then only grants decide.
# For the Feedbacksystem e.g. TOP_CLAIM=globalRole and TOP_VALUES=ADMIN.
TOP_CLAIM=
TOP_VALUES=
# Seconds an expired token is still accepted, to absorb clock drift. 0 means strict.
JWT_CLOCK_TOLERANCE=5

# Largest message a WebSocket client may send, in bytes; a larger one closes the connection.
# At most 15 MiB, since MongoDB keeps one change in one document of at most 16 MiB.
# Blank means 8 MiB.
MAX_MESSAGE_BYTES=
# Largest awareness update (cursor, selection, name), in bytes. It goes to everyone every
# 15 seconds, so it is kept small. Blank means 64 KiB.
MAX_AWARENESS_BYTES=
# Web origins that may open a WebSocket or call the routes, comma-separated and as the
# browser sends them: https://tool.example, no path, no trailing slash. Blank means every origin.
ALLOWED_ORIGINS=

# States of tasks and comments that are a decision, comma-separated, e.g. accepted,rejected.
# Setting one takes the right decide; any other state takes plan (tasks) or speak (comments).
# Blank means no state is a decision.
DECISION_STATES=
