# Laufzeitumgebung: development | production | test
NODE_ENV=development

# Port auf dem der HTTP- und WebSocket-Server lauscht
PORT=3000

# Erlaubte CORS-Origins
# Entwicklung: * erlaubt alle Origins (localhost, Kollegen im selben Netz)
# Produktion:  Hochschul-Domain eintragen, z.B. https://meine-hochschule.de
CORS_ORIGIN=*

# PostgreSQL-Verbindung (im Docker: Hostname = Service-Name "postgres")
DB_HOST=localhost
DB_PORT=5432
DB_NAME=projekt5
DB_USER=postgres
DB_PASSWORD=postgres

# Redis-Verbindung (im Docker: Hostname = Service-Name "redis")
REDIS_HOST=localhost
REDIS_PORT=6379

# M12 — Auth-Anbindung Plattform-Projekt
# URL des Token-Validierungs-Endpoints von Projekt 1.
# Nicht gesetzt → Entwicklungs-/Testmodus: Fallback-Nutzer "dev-user" aktiv, kein 401.
# Gesetzt → Produktionsmodus: Bearer-Token erforderlich, ungültige Tokens → 401.
# Beispiel: AUTH_SERVICE_URL=http://projekt1-api/auth/validate
#
# Lokal testen OHNE Projekt 1: Mock-Auth-Service starten (npm run mock:auth) und setzen:
#   AUTH_SERVICE_URL=http://localhost:4000/validate
# Test-Tokens des Mocks: alice | bob | carol | <beliebig> (eigener Nutzer) | invalid/expired (→401)
AUTH_SERVICE_URL=

# Optional: Feldnamen-Override, falls Projekt 1 abweichende Felder liefert
# (Standard deckt userId/sub/id bzw. name/displayName/username bereits ab).
# AUTH_FIELD_ID=uuid
# AUTH_FIELD_NAME=fullName

# ============================================================================
# STELLSCHRAUBEN — alle optional. Ohne Eintrag gilt der gezeigte Default.
# Zentral gelesen/validiert in src/config/settings.ts (dort auch dokumentiert).
# ============================================================================

# ── Logging / Betrieb / Rollen ──────────────────────────────────────────────
# LOG_LEVEL=info                 # trace|debug|info|warn|error
# METRICS_TOKEN=                 # Bearer-Schutz für /metrics (leer = offen)
# DEV_ENFORCE_ROLES=false        # true = echte Rollen auch ohne Auth-Service (lokales Rollen-Testen)

# ── Change-/Konflikt-Awareness (Schicht 2) ──────────────────────────────────
# AWARENESS_FRESH_MS=45000       # Konflikt-Fenster: „frisch" = jünger als das
# AWARENESS_FEED_MS=2000         # Drossel des passiven Änderungs-Feeds
# AWARENESS_OVERLAP_MS=3000      # Fenster „zwei ändern dasselbe Element" (Regel C)
# CONFLICT_NOTIFY_MS=30000       # Glocken-Drossel für Konflikte (je Session)
# CONFLICT_COOLDOWN_MS=2000      # Sperre gegen Konflikt-Spam je (Element, Opfer)
# CONFLICT_ACK_SUPPRESS_MS=5000  # Ruhe nach „Behalten/Privat"-Quittierung

# ── WebSocket ────────────────────────────────────────────────────────────────
# WS_MAX_CONN_PER_USER=20        # max. gleichzeitige WS-Verbindungen pro Nutzer
# WS_MAX_PAYLOAD=5242880         # max. WS-Frame-Größe in Bytes (5 MB)

# ── Speichern / Persistenz ───────────────────────────────────────────────────
# SAVE_DEBOUNCE_MS=5000          # Wartezeit nach letzter Änderung bis persistiert wird
# REDIS_SNAPSHOT_TTL_SECONDS=86400  # TTL des Live-Snapshots im Redis-Cache (24 h)

# ── Verlauf (History): wie viele MANUELLE Stände behalten werden ─────────────
# HISTORY_SESSION_LIMIT=10       # Stände pro Session (geteilter Verlauf)
# HISTORY_PERSONAL_LIMIT=5       # Stände pro Nutzer (persönlicher Verlauf, + 1 Auto-Slot)

# ── Einladungen ──────────────────────────────────────────────────────────────
# INVITE_TTL_SECONDS=604800      # Gültigkeit eines Einladungs-Tokens (7 Tage)

# ── HTTP / Rate-Limit ────────────────────────────────────────────────────────
# HTTP_BODY_LIMIT=1mb            # max. JSON-Body-Größe (große Modelle → z. B. 5mb)
# RATE_LIMIT_WINDOW_MS=900000    # Rate-Limit-Fenster (15 min)
# RATE_LIMIT_MAX=200             # Requests je Fenster/IP (Dev-Default 2000)

# ── Datenbank ────────────────────────────────────────────────────────────────
# DB_POOL_MAX=25                 # max. PostgreSQL-Verbindungen im Pool

# ── Aufbewahrung / DSGVO (nur vom CLI-Skript db/retention.ts gelesen) ────────
# RETENTION_MONTHS=6             # inaktive Sessions älter als X Monate löschen
# CHANGELOG_RETENTION_DAYS=90    # change_log-Einträge älter als X Tage löschen
