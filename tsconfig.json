{
  "compilerOptions": {
    // Ziel-JavaScript-Version — ES2020 unterstützt async/await, optional chaining, nullish coalescing
    "target": "ES2020",
    // Modul-System: CommonJS für Node.js (require/module.exports)
    "module": "commonjs",
    // Verfügbare Standard-Bibliotheken (DOM wird nicht benötigt, nur Node)
    "lib": ["ES2020"],
    // Kompilierter Output landet in dist/
    "outDir": "./dist",
    // Quellcode liegt in src/
    "rootDir": "./src",
    // Strict-Modus: aktiviert alle strengen Typ-Checks (null-checks, implicit any, …)
    "strict": true,
    // Erlaubt default-imports für CommonJS-Module (z.B. import express from 'express')
    "esModuleInterop": true,
    // Überspringt Typ-Checks in node_modules — schnellerer Build
    "skipLibCheck": true,
    // Verhindert Fehler durch Groß-/Kleinschreibung in Dateinamen (wichtig auf macOS/Linux)
    "forceConsistentCasingInFileNames": true,
    // Erlaubt import von .json-Dateien
    "resolveJsonModule": true,
    // Erzeugt .d.ts Typ-Deklarationen für andere Projekte die dieses als Paket nutzen
    "declaration": true,
    // Erzeugt Source-Maps für die .d.ts Dateien
    "declarationMap": true,
    // Source-Maps für Debugging (Fehler zeigen auf .ts-Zeilen, nicht kompiliertes JS)
    "sourceMap": true,
    "types": ["node", "jest"]
  },
  // Kompiliert alle .ts Dateien unter src/
  "include": ["src/**/*"],
  "exclude": ["node_modules", "dist"]
}
