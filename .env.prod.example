# Produktions-Umgebungsvariablen
# Kopieren nach .env.prod und Werte ausfüllen — diese Datei NICHT mit echten Werten einchecken!
# Starten mit: docker-compose -f docker-compose.prod.yml up

# Sicheres Datenbankpasswort (min. 16 Zeichen, kein "postgres"!)
DB_PASSWORD=HIER_SICHERES_PASSWORT_SETZEN

# Sicheres Redis-Passwort
REDIS_PASSWORD=HIER_SICHERES_PASSWORT_SETZEN

# Nur die Domain der Hochschule erlauben (kein Wildcard *)
CORS_ORIGIN=https://meine-hochschule.de

# URL des Auth-Endpoints von Projekt 1
AUTH_SERVICE_URL=http://projekt1-service/auth/validate

# Geheimes Token zum Schutz von /metrics (Prometheus scrapt damit intern app:3000/metrics)
METRICS_TOKEN=HIER_SICHERES_TOKEN_SETZEN

# N3 — WebSocket-Abuse-Schutz (optional; Defaults: 20 Verbindungen/Nutzer, 5 MB Frame)
# WS_MAX_CONN_PER_USER=20
# WS_MAX_PAYLOAD=5242880
