{
  "name": "collab-kit",
  "version": "0.1.0",
  "private": true,
  "description": "Backend service that makes single-user tools collaborative and cooperative",
  "type": "module",
  "engines": {
    "node": "^24"
  },
  "scripts": {
    "dev": "node --watch --env-file-if-exists=.env src/app.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node --env-file-if-exists=.env dist/app.js",
    "token": "node --env-file-if-exists=.env scripts/token.ts",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:up": "docker compose up -d --wait mongo",
    "db:down": "docker compose down",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "seed": "node --env-file-if-exists=.env scripts/seed.ts"
  },
  "dependencies": {
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "mongodb": "^7.6.0",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "ws": "^8.21.3",
    "y-protocols": "^1.0.7",
    "yjs": "^13.6.32"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^24.13.5",
    "@types/supertest": "^7.2.1",
    "@types/ws": "^8.18.1",
    "oxlint": "^1.83.0",
    "prettier": "^3.9.7",
    "supertest": "^7.2.2",
    "typescript": "^7.0.2",
    "vite": "^8.3.0",
    "vitest": "^5.0.1"
  }
}
